{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    },
    {
      "source": "functions/cs2-nexus",
      "codebase": "cs2-nexus",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "site": "studiosgamesrs",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "predeploy": [
      "node tools/verify-site-assets.js local",
      "node scripts/build-hosting-routes.js",
      "node scripts/verify-hosting-files.js"
    ],
    "postdeploy": [
      "node tools/verify-site-assets.js live"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      "tools/**",
      "scripts/**",
      "docs/**",
      "cs2-server/**",
      "**/node_modules/**",
      "functions/**",
      "*.md",
      "*.php",
      "**/*.php",
      "serviceAccountKey.json",
      "animations/**",
      "Animations/**",
      "tools_tmp_*/**",
      "tmp-*"
    ],
    "redirects": [
      { "source": "/", "destination": "/login", "type": 302 }
    ],
    "rewrites": [
      { "source": "/login", "destination": "/login.html" },
      { "source": "/dashboard", "destination": "/dashboard.html" },
      { "source": "/competition-hub", "destination": "/competition-hub.html" },
      { "source": "/tournament-details", "destination": "/tournament-details.html" },
      { "source": "/commander-panel", "destination": "/commander-panel.html" },
      { "source": "/community", "destination": "/community.html" },
      { "source": "/nexus", "destination": "/nexus.html" },
      { "source": "/playzone", "destination": "/playzone.html" },
      { "source": "/steam-login-handler", "destination": "/steam-login-handler.html" },
      { "source": "/steam-callback", "destination": "/steam-callback.html" },
      { "source": "/steam_bridge", "destination": "/steam_bridge.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "comment": "cleanUrls sirve /dashboard sin extension, asi que la regla de *.html no lo alcanza y el HTML quedaba cacheado con versiones viejas de js/css.",
        "source": "/@(login|dashboard|playzone|community|nexus|competition-hub|tournament-details|commander-panel|steam-callback|steam-login-handler|steam_bridge)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/models/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(css|png)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}
