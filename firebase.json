{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "studiosgamesrs",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "predeploy": [
      "node tools/verify-site-assets.js local"
    ],
    "postdeploy": [
      "node tools/verify-site-assets.js live"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      "tools/**",
      "**/node_modules/**",
      "functions/**",
      "*.md",
      "steam_login.php",
      "steam-config.php",
      "serviceAccountKey.json",
      "animations/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/models/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**/*.@(css|png)",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  }
}
