# Cloud / CS2 (loaded by Firebase Functions on deploy — never commit real values)

# Provider: vultr (default, Miami) or hetzner (legacy — see docs/LOCATION.md)
CS2_CLOUD_PROVIDER=vultr

# Vultr (default — Florida-friendly Miami region)
VULTR_API_TOKEN=
VULTR_LOCATION=mia
VULTR_PLAN=vc2-4c-8gb
VULTR_OS_ID=2284
VULTR_SNAPSHOT_ID=

# Hetzner (legacy — only when CS2_CLOUD_PROVIDER=hetzner)
HETZNER_API_TOKEN=
HETZNER_LOCATION=ash
HETZNER_SERVER_TYPE=cpx31
HETZNER_IMAGE=ubuntu-24.04
HETZNER_SNAPSHOT_ID=

RCON_PASSWORD=
GSLT_SERVER_1=
GSLT_SERVER_2=

WEBHOOK_SECRET=
CS2_WEBHOOK_URL=https://us-central1-studiosgamesrs.cloudfunctions.net/cs2MatchWebhook

# In-game team logo (mp_teamlogo_1/2). CS2_LOGO_BASE_URL defaults to the Firebase
# Hosting mirror (cs2-fastdl/) if left empty — only override for local testing.
# CS2_LOGO_WORKSHOP_ID stays empty until the logo is published as a Steam Workshop
# item (manual, one-time, needs a real Steam account — see docs/CS2-INGAME-LOGO.md).
# Without it, mp_teamlogo shows the logo only to the server operator and to anyone who
# copies the same files into their own CS2 install; it is NOT sent to every player.
CS2_LOGO_BASE_URL=
CS2_LOGO_WORKSHOP_ID=
