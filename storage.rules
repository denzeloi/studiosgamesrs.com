rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /community_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }
    match /community_clips/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024;
    }
    match /creatorMarket/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                     (request.resource.contentType.matches('image/.*')
                       && request.resource.size < 15 * 1024 * 1024)
                     || (request.resource.contentType.matches('video/.*')
                       && request.resource.size < 100 * 1024 * 1024)
                   );
    }
    match /profileCustomizationAssets/{type}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && (type == 'background' || type == 'frame')
                   && request.resource != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && (type == 'background' || type == 'frame');
    }
    match /team_emblems/{teamId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /profile_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /chat_images/{teamId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // PZ-022: el chatRoomID viene de [uidA, uidB].sort().join('_') (igual que en
    // database.rules.json -> privateChats, ver PZ-021). No hay split() confiable
    // porque un UID de Steam ya trae "_" adentro (steam_<steamid>), asi que se
    // ancla con la misma tecnica que en RTDB: el propio uid debe ser exactamente
    // el primer o el segundo componente del par, no una subcadena cualquiera.
    match /private_chat_images/{chatRoomID}/{fileName} {
      allow read: if request.auth != null
                   && (chatRoomID.matches('^' + request.auth.uid + '_.*')
                       || chatRoomID.matches('.*_' + request.auth.uid + '$'));
      allow write: if request.auth != null
                   && (chatRoomID.matches('^' + request.auth.uid + '_.*')
                       || chatRoomID.matches('.*_' + request.auth.uid + '$'))
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
