rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /community_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }
    match /community_clips/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024;
    }
    match /creatorMarket/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                     (request.resource.contentType.matches('image/.*')
                       && request.resource.size < 15 * 1024 * 1024)
                     || (request.resource.contentType.matches('video/.*')
                       && request.resource.size < 100 * 1024 * 1024)
                   );
    }
    match /profileCustomizationAssets/{type}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && (type == 'background' || type == 'frame')
                   && request.resource != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && (type == 'background' || type == 'frame');
    }
    // Las reglas de Storage no pueden consultar Realtime Database, así que aquí
    // no hay forma de preguntar quién organiza el torneo o capitanea el equipo.
    // Lo que sí se puede es que nadie escriba encima de nadie: cada quien sube
    // dentro de su propia carpeta. Antes bastaba con conocer el identificador
    // para reemplazar la portada de un torneo ajeno o el emblema de un rival,
    // porque el archivo tenía nombre fijo y estaba abierto a cualquiera.
    //
    // Quién manda de verdad es el puntero en la base: tournaments/{id}/bannerUrl
    // solo lo escribe la organización y teams/{id}/emblem solo el capitán. Una
    // subida sin permiso se queda en un archivo que no mira nadie.
    match /tournament_banners/{tournamentId}/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 6 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Portadas subidas antes del cambio: se siguen viendo, ya no se tocan.
    match /tournament_banners/{tournamentId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /team_emblems/{teamId}/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /team_emblems/{teamId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /profile_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /chat_images/{teamId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 4 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // PZ-022: el chatRoomID viene de [uidA, uidB].sort().join('_') (igual que en
    // database.rules.json -> privateChats, ver PZ-021). No hay split() confiable
    // porque un UID de Steam ya trae "_" adentro (steam_<steamid>), asi que se
    // ancla con la misma tecnica que en RTDB: el propio uid debe ser exactamente
    // el primer o el segundo componente del par, no una subcadena cualquiera.
    match /private_chat_images/{chatRoomID}/{fileName} {
      allow read: if request.auth != null
                   && (chatRoomID.matches('^' + request.auth.uid + '_.*')
                       || chatRoomID.matches('.*_' + request.auth.uid + '$'));
      allow write: if request.auth != null
                   && (chatRoomID.matches('^' + request.auth.uid + '_.*')
                       || chatRoomID.matches('.*_' + request.auth.uid + '$'))
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
